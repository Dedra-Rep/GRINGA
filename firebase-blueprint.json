{
  "entities": {
    "FounderLead": {
      "title": "Founder Lead",
      "description": "Stores emails and consent for interested founders.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "source": { "type": "string" },
        "locale": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "consentAccepted": { "type": "boolean" }
      },
      "required": ["email", "consentAccepted"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user profile and care settings (auth or session based).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "locale": { "type": "string" },
        "preferredTone": { "type": "string" },
        "mainGoal": { "type": "string" },
        "dailyCareFocus": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firstName"]
    },
    "ImportantThing": {
      "title": "Important Thing",
      "description": "Stores things that the user doesn't want to forget (people, goals, health, money, documents etc.).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "relatedPerson": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "title"]
    }
  },
  "firestore": {
    "/founderLeads/{leadId}": {
      "schema": "FounderLead",
      "description": "Leads of product interested founders."
    },
    "/userProfiles/{profileId}": {
      "schema": "UserProfile",
      "description": "User profiles stored by uid or sessionId."
    },
    "/importantThings/{thingId}": {
      "schema": "ImportantThing",
      "description": "Important things stored by users or sessionIds."
    }
  }
}
